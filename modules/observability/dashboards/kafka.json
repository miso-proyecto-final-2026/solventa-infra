    {
      "id": 1,
      "type": "stat",
      "title": "Particiones sin réplica suficiente",
      "description": "Debe ser 0: un valor mayor indica que un broker no está al día.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 1,
          "metricEditorMode": 1,
          "sqlExpression": "SELECT MAX(UnderReplicatedPartitions) FROM \"AWS/Kafka\" WHERE \"Cluster Name\" = '$cluster'",
          "region": "default",
          "id": "",
          "label": "UnderReplicatedPartitions",
          "period": "",
          "namespace": "",
          "metricName": "",
          "dimensions": {},
          "matchExact": true,
          "statistic": "Average",
          "expression": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
