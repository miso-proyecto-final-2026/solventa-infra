  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timezone": "browser",
  "description": "Eventos de Kafka (MSK) por topic: mensajes y bytes por segundo, y desfase de cada grupo de consumo. Las métricas llegan de CloudWatch con 1 a 5 minutos de retraso; un topic sin tráfico no aparece.",
  "links": [
    {
      "type": "dashboards",
      "title": "Solventa",
      "tags": [
        "solventa"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Clúster",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "cloudwatch"
        },
        "query": "dimension_values(default,AWS/Kafka,BytesInPerSec,Cluster Name)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "sort": 1,
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        }
      },
      {
        "name": "topic",
        "label": "Topic",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "cloudwatch"
        },
        "query": "dimension_values(default,AWS/Kafka,BytesInPerSec,Topic)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "group",
        "label": "Grupo de consumo",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "cloudwatch"
        },
        "query": "dimension_values(default,AWS/Kafka,MaxOffsetLag,Consumer Group)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
